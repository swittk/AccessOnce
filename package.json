{
  "name": "@accessonce/core",
  "version": "0.0.1",
  "description": "Fast compiled authorization kernel with bring-your-own storage, relationship, query, and transport adapters.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist-cjs/react.js"
    },
    "./authzen": {
      "types": "./dist/authzen/index.d.ts",
      "import": "./dist/authzen/index.js",
      "require": "./dist-cjs/authzen/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist-cjs/client.js"
    },
    "./control": {
      "types": "./dist/control-wire.d.ts",
      "import": "./dist/control-wire.js",
      "require": "./dist-cjs/control-wire.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && node scripts/check-source-quality.mjs",
    "test": "vitest run",
    "formal": "node scripts/run-formal.mjs",
    "assurance:implementation": "node scripts/check-formal-implementation-conformance.mjs",
    "perf": "pnpm build:esm && node scripts/benchmark.mjs && node --expose-gc scripts/benchmark-memory.mjs",
    "assurance": "pnpm check && pnpm test && pnpm formal && pnpm assurance:manifest && pnpm build && pnpm consumer:smoke && pnpm perf",
    "assurance:manifest": "node scripts/check-formal-implementation-conformance.mjs",
    "consumer:smoke": "node scripts/consumer-smoke.mjs",
    "test:consumer": "pnpm build && pnpm consumer:smoke",
    "assurance:update": "node scripts/check-formal-implementation-conformance.mjs --write",
    "perf:throughput": "pnpm build:esm && node scripts/benchmark.mjs",
    "perf:memory": "pnpm build:esm && node --expose-gc scripts/benchmark-memory.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "typesVersions": {
    "*": {
      "react": [
        "dist/react.d.ts"
      ],
      "authzen": [
        "dist/authzen/index.d.ts"
      ],
      "client": [
        "dist/client.d.ts"
      ],
      "control": [
        "dist/control-wire.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
